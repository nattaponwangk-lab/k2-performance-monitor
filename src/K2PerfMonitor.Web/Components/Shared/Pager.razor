@typeparam T
@using K2PerfMonitor.Web.Services

@if (Total > Grid.PageSize)
{
    <div class="pager">
        <button class="btn btn-sm btn-outline-light" disabled="@(Grid.Page <= 1)" @onclick="Prev">‹ ก่อนหน้า</button>
        <span class="mono">หน้า @Grid.Page / @Grid.TotalPages(Total) · @Total รายการ</span>
        <button class="btn btn-sm btn-outline-light" disabled="@(Grid.Page >= Grid.TotalPages(Total))" @onclick="Next">ถัดไป ›</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public GridState<T> Grid { get; set; } = default!;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task Prev() { Grid.PrevPage(); await OnChanged.InvokeAsync(); }
    private async Task Next() { Grid.NextPage(Total); await OnChanged.InvokeAsync(); }
}
