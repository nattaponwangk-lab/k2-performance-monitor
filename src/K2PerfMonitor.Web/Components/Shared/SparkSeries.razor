@* Simple inline SVG sparkline — วาดจาก List<ChartPoint> *@
<div class="spark-wrap">
    <svg viewBox="0 0 100 40" preserveAspectRatio="none" class="spark-svg">
        @if (Points.Count > 1)
        {
            var maxV = Max;
            var pts = Points.Select((p, i) =>
            {
                var x = (double)i / (Points.Count - 1) * 100;
                var y = 40 - (p.Value / maxV * 38) - 1;
                return (x, y);
            }).ToList();

            var line = string.Join(" ", pts.Select(p => $"{p.x:F2},{p.y:F2}"));
            var area = $"0,40 {line} 100,40";

            <polygon points="@area" fill="@Color" fill-opacity="0.15" />
            <polyline points="@line" fill="none" stroke="@Color" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        }
    </svg>
    <div class="spark-axis">
        <span>@Points.First().Time.ToLocalTime().ToString("HH:mm")</span>
        <span>@Points.Last().Value.ToString("0.0")%</span>
        <span>@Points.Last().Time.ToLocalTime().ToString("HH:mm")</span>
    </div>
</div>

@code {
    [Parameter] public List<ChartPoint> Points { get; set; } = new();
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string Color { get; set; } = "var(--accent)";
}

<style>
    .spark-wrap { display: flex; flex-direction: column; gap: 4px; }
    .spark-svg { width: 100%; height: 120px; display: block; }
    .spark-axis {
        display: flex; justify-content: space-between;
        color: var(--text-muted); font-size: .72rem;
    }
</style>
