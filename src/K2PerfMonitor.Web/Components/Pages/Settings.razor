@page "/settings"
@rendermode InteractiveServer

<PageTitle>Settings — K2 Performance Monitor</PageTitle>

<div class="page-head">
    <div>
        <h1>⚙️ Settings</h1>
        <div class="desc">ตั้งค่าระบบ — Connection strings, Notification channels, Alert rules, Collector intervals</div>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
    <div class="panel">
        <div class="panel-title">Connection Strings</div>
        <div class="panel-sub">กำหนด SQL Server instances สำหรับ monitoring</div>
        <div style="display:flex; flex-direction:column; gap:12px;">
            <div>
                <label class="sev-info" style="font-size:.78rem;">Monitor DB (เก็บ metrics)</label>
                <input class="form-control form-control-sm" placeholder="Server=.;Database=K2PerfMonitor;Trusted_Connection=true;" disabled value="*** mock mode ***" />
            </div>
            <div>
                <label class="sev-info" style="font-size:.78rem;">Source DB (DMV queries)</label>
                <input class="form-control form-control-sm" placeholder="Server=.;Database=K2;Trusted_Connection=true;" disabled value="*** mock mode ***" />
            </div>
            <div>
                <label class="sev-info" style="font-size:.78rem;">K2 Database</label>
                <input class="form-control form-control-sm" placeholder="Server=.;Database=K2;Trusted_Connection=true;" disabled value="*** mock mode ***" />
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-title">Notification Channels</div>
        <div class="panel-sub">กำหนดช่องทางการแจ้งเตือน</div>
        <div style="display:flex; flex-direction:column; gap:12px;">
            <div style="display:flex; align-items:center; gap:10px;">
                <input type="checkbox" checked disabled />
                <span style="min-width:60px; font-weight:600;">LINE</span>
                <input class="form-control form-control-sm" disabled value="*** mock mode ***" />
                <span class="badge badge-ok">Active</span>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
                <input type="checkbox" checked disabled />
                <span style="min-width:60px; font-weight:600;">Teams</span>
                <input class="form-control form-control-sm" disabled value="*** mock mode ***" />
                <span class="badge badge-ok">Active</span>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
                <input type="checkbox" checked disabled />
                <span style="min-width:60px; font-weight:600;">Email</span>
                <input class="form-control form-control-sm" disabled value="*** mock mode ***" />
                <span class="badge badge-ok">Active</span>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-title">Collector Intervals</div>
        <div class="panel-sub">รอบเวลาเก็บข้อมูล (วินาที)</div>
        <div style="display:flex; flex-direction:column; gap:10px;">
            <div style="display:flex; justify-content:space-between;"><span>🖥️ Server Stats (CPU/RAM)</span><span class="mono">15s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>🐌 Slow Queries</span><span class="mono">60s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>⏳ Wait Stats</span><span class="mono">60s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>🔒 Blocking</span><span class="mono">30s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>💀 Deadlocks</span><span class="mono">120s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>📇 Indexes</span><span class="mono">300s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>💾 I/O</span><span class="mono">120s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>⚙️ Stored Procs</span><span class="mono">120s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>🔄 K2 Workflows</span><span class="mono">60s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>📋 K2 SmartForms</span><span class="mono">120s</span></div>
            <div style="display:flex; justify-content:space-between;"><span>🧱 K2 SmartObjects</span><span class="mono">120s</span></div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-title">Data Retention</div>
        <div class="panel-sub">ล้างข้อมูลเก่าตามจำนวนวัน</div>
        <div style="display:flex; align-items:center; gap:10px;">
            <span>ล้างข้อมูลที่เก่ากว่า</span>
            <input class="form-control form-control-sm" style="width:80px; text-align:center;" disabled value="30" />
            <span>วัน</span>
        </div>
        <div style="margin-top:14px;">
            <div class="sev-info" style="font-size:.78rem;">Alert rules มีอยู่ 15 กฎ (default) — สามารถปรับในหน้า Settings ภายหลังได้</div>
        </div>
    </div>
</div>
