@page "/indexes"
@rendermode InteractiveServer
@inject MetricQueryService Metrics
@inject IJSRuntime JS

<PageTitle>Index Recommendations — K2 Performance Monitor</PageTitle>

<div class="page-head">
    <div>
        <h1>🔑 Index Recommendations</h1>
        <div class="desc">Missing (impact) + Unused index จาก DMV
            @if (result?.AsOfUtc is not null) { <span class="badge badge-ok">as of @result.AsOfUtc.Value.ToLocalTime().ToString("HH:mm:ss")</span> }
        </div>
    </div>
    <div class="toolbar">
        <input class="inp" placeholder="🔍 table / database" value="@grid.Search" @oninput="e => grid.SetSearch(e.Value?.ToString())" />
        <button class="btn btn-sm btn-outline-light @(typeFilter==""?"active":"")" @onclick='() => SetType("")'>ทั้งหมด</button>
        <button class="btn btn-sm btn-outline-light @(typeFilter=="Missing"?"active":"")" @onclick='() => SetType("Missing")'>Missing</button>
        <button class="btn btn-sm btn-outline-light @(typeFilter=="Unused"?"active":"")" @onclick='() => SetType("Unused")'>Unused</button>
        <button class="btn btn-sm btn-outline-light" @onclick="ExportCsv">⬇ CSV</button>
        <button class="btn btn-sm btn-outline-light" @onclick="Load">↻ Refresh</button>
    </div>
</div>

<div class="panel">
    <StatusView T="IndexRecommendationVm" Result="result">
        @{
            var filteredByType = typeFilter == "" ? result!.Items : result!.Items.Where(x => x.RecommendationType == typeFilter).ToList();
            var all = grid.Filtered(filteredByType);
            var rows = grid.PageOf(all);
        }
        <table class="tbl">
            <thead><tr>
                <th>Type</th><th>DB</th>
                <th class="sortable" @onclick='() => grid.ToggleSort("table")'>Table@(grid.SortIndicator("table"))</th>
                <th>Columns / Index</th>
                <th class="sortable" style="text-align:right" @onclick='() => grid.ToggleSort("impact")'>Impact@(grid.SortIndicator("impact"))</th>
                <th style="text-align:right">Seeks/Scans</th>
                <th>Script</th>
            </tr></thead>
            <tbody>
                @foreach (var ix in rows)
                {
                    <tr>
                        <td><span class="badge badge-@(ix.RecommendationType=="Missing"?"warning":"info")">@ix.RecommendationType</span></td>
                        <td>@ix.DatabaseName</td>
                        <td class="mono">@ix.TableName</td>
                        <td class="mono" style="font-size:.78rem">@(ix.RecommendationType == "Missing" ? $"{ix.EqualityColumns} {ix.InequalityColumns}".Trim() : ix.IndexName)</td>
                        <td style="text-align:right" class="mono">@(ix.RecommendationType == "Missing" ? ix.Impact.ToString("0") + "%" : "-")</td>
                        <td style="text-align:right" class="mono">@ix.UserSeeks.ToString("N0")/@ix.UserScans.ToString("N0")</td>
                        <td><code style="font-size:.72rem">@Trunc(ix.RecommendationScript, 60)</code></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Grid="grid" Total="all.Count" OnChanged="StateHasChanged" />
    </StatusView>
</div>

@code {
    private QueryResult<IndexRecommendationVm>? result;
    private string typeFilter = "";
    private readonly GridState<IndexRecommendationVm> grid = new(
        ix => $"{ix.TableName} {ix.DatabaseName} {ix.IndexName}",
        new() { ["table"] = ix => ix.TableName ?? "", ["impact"] = ix => ix.Impact }, "impact");

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { result = null; result = await Metrics.GetIndexRecommendationsAsync(); }
    private void SetType(string t) => typeFilter = t;

    private async Task ExportCsv()
    {
        if (result?.Items is null) return;
        var csv = Csv.Build(grid.Filtered(result.Items),
            ("Type", ix => ix.RecommendationType), ("Database", ix => ix.DatabaseName), ("Table", ix => ix.TableName),
            ("Equality", ix => ix.EqualityColumns), ("Included", ix => ix.IncludedColumns), ("IndexName", ix => ix.IndexName),
            ("Impact", ix => ix.Impact), ("Script", ix => ix.RecommendationScript));
        await JS.InvokeVoidAsync("k2pm.downloadFile", $"index-recommendations-{DateTime.Now:yyyyMMdd-HHmmss}.csv", csv, "text/csv");
    }

    private static string Trunc(string? s, int n) => string.IsNullOrEmpty(s) ? "" : s.Length <= n ? s : s[..n] + "…";
}
