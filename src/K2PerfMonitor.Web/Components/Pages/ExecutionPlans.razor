@page "/execution-plans"
@rendermode InteractiveServer
@inject MetricQueryService Metrics
@inject IJSRuntime JS

<PageTitle>Execution Plans — K2 Performance Monitor</PageTitle>

<div class="page-head">
    <div>
        <h1>🗺️ Execution Plans</h1>
        <div class="desc">Query plan ของ top slow queries จาก <code>sys.dm_exec_query_plan</code> — คลิกเพื่อดู XML
            @if (result?.AsOfUtc is not null) { <span class="badge badge-ok">as of @result.AsOfUtc.Value.ToLocalTime().ToString("HH:mm:ss")</span> }
        </div>
    </div>
    <div class="toolbar">
        <input class="inp" placeholder="🔍 query / object" value="@grid.Search" @oninput="e => grid.SetSearch(e.Value?.ToString())" />
        <button class="btn btn-sm btn-outline-light" @onclick="Load">↻ Refresh</button>
    </div>
</div>

<div class="panel">
    <StatusView T="ExecutionPlanVm" Result="result">
        @{ var all = grid.Filtered(result!.Items); var rows = grid.PageOf(all); }
        <table class="tbl">
            <thead><tr>
                <th>Severity</th><th>Query</th><th>DB</th>
                <th class="sortable" style="text-align:right" @onclick='() => grid.ToggleSort("avg")'>Avg ms@(grid.SortIndicator("avg"))</th>
                <th style="text-align:right">Avg CPU ms</th><th style="text-align:right">Avg Reads</th><th></th>
            </tr></thead>
            <tbody>
                @foreach (var p in rows)
                {
                    <tr class="clickable" @onclick="() => Toggle(p.QueryHash)">
                        <td><span class="badge badge-@(p.Severity.ToString().ToLower())">@p.Severity</span></td>
                        <td class="query-cell"><div class="mono">@p.QueryHash</div><div class="qtxt">@Trunc(p.QueryText, 90)</div></td>
                        <td>@p.DatabaseName</td>
                        <td style="text-align:right" class="mono">@p.AvgDurationMs.ToString("N0")</td>
                        <td style="text-align:right" class="mono">@p.AvgCpuMs.ToString("N0")</td>
                        <td style="text-align:right" class="mono">@p.AvgLogicalReads.ToString("N0")</td>
                        <td>@(expanded == p.QueryHash ? "▲" : "▼ plan")</td>
                    </tr>
                    @if (expanded == p.QueryHash)
                    {
                        <tr class="detail-row"><td colspan="7"><div class="detail">
                            <strong>Showplan XML</strong>
                            <button class="btn btn-sm btn-outline-light" @onclick="() => DownloadPlan(p)">⬇ .sqlplan</button>
                            <pre class="code" style="max-height:340px;overflow:auto">@p.PlanXml</pre>
                        </div></td></tr>
                    }
                }
            </tbody>
        </table>
        <Pager Grid="grid" Total="all.Count" OnChanged="StateHasChanged" />
    </StatusView>
</div>

@code {
    private QueryResult<ExecutionPlanVm>? result;
    private string? expanded;
    private readonly GridState<ExecutionPlanVm> grid = new(
        p => $"{p.QueryText} {p.ObjectName} {p.QueryHash}",
        new() { ["avg"] = p => p.AvgDurationMs }, "avg");

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { result = null; result = await Metrics.GetExecutionPlansAsync(); }
    private void Toggle(string h) => expanded = expanded == h ? null : h;

    private async Task DownloadPlan(ExecutionPlanVm p)
        => await JS.InvokeVoidAsync("k2pm.downloadFile", $"plan-{p.QueryHash}.sqlplan", p.PlanXml, "application/xml");

    private static string Trunc(string? s, int n) => string.IsNullOrEmpty(s) ? "" : s.Length <= n ? s : s[..n] + "…";
}
