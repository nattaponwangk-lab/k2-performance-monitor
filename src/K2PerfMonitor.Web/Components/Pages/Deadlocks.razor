@page "/deadlocks"
@rendermode InteractiveServer
@inject MetricQueryService Metrics
@inject IJSRuntime JS

<PageTitle>Deadlocks — K2 Performance Monitor</PageTitle>

<div class="page-head">
    <div>
        <h1>💀 Deadlocks</h1>
        <div class="desc">ประวัติ deadlock จาก system_health Extended Events</div>
    </div>
    <div class="toolbar">
        <input class="inp" placeholder="🔍 login / query" value="@grid.Search" @oninput="e => grid.SetSearch(e.Value?.ToString())" />
        <button class="btn btn-sm btn-outline-light" @onclick="ExportCsv">⬇ CSV</button>
        <button class="btn btn-sm btn-outline-light" @onclick="Load">↻ Refresh</button>
    </div>
</div>

<div class="panel">
    <StatusView T="DeadlockVm" Result="result">
        <EmptyContent><div class="empty">✅ ไม่พบ deadlock ในประวัติ system_health</div></EmptyContent>
        <ChildContent>
            @{ var all = grid.Filtered(result!.Items); var rows = grid.PageOf(all); }
            <table class="tbl">
                <thead><tr>
                    <th class="sortable" @onclick='() => grid.ToggleSort("time")'>เวลา@(grid.SortIndicator("time"))</th>
                    <th>Victim</th><th>Victim Query</th><th>Survivor</th><th>Survivor Query</th>
                </tr></thead>
                <tbody>
                    @foreach (var d in rows)
                    {
                        <tr>
                            <td class="mono">@d.DeadlockAtUtc.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                            <td>@d.VictimLoginName <div class="mono" style="font-size:.72rem;opacity:.6">@d.VictimProcessId</div></td>
                            <td class="mono" style="font-size:.75rem;max-width:280px">@Trunc(d.VictimQueryText, 120)</td>
                            <td>@d.SurvivorLoginName</td>
                            <td class="mono" style="font-size:.75rem;max-width:280px">@Trunc(d.SurvivorQueryText, 120)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pager Grid="grid" Total="all.Count" OnChanged="StateHasChanged" />
        </ChildContent>
    </StatusView>
</div>

@code {
    private QueryResult<DeadlockVm>? result;
    private readonly GridState<DeadlockVm> grid = new(
        d => $"{d.VictimLoginName} {d.SurvivorLoginName} {d.VictimQueryText} {d.SurvivorQueryText}",
        new() { ["time"] = d => d.DeadlockAtUtc }, "time");

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { result = null; result = await Metrics.GetDeadlocksAsync(); }

    private async Task ExportCsv()
    {
        if (result?.Items is null) return;
        var csv = Csv.Build(grid.Filtered(result.Items),
            ("Time", d => d.DeadlockAtUtc), ("VictimLogin", d => d.VictimLoginName), ("VictimQuery", d => d.VictimQueryText),
            ("SurvivorLogin", d => d.SurvivorLoginName), ("SurvivorQuery", d => d.SurvivorQueryText));
        await JS.InvokeVoidAsync("k2pm.downloadFile", $"deadlocks-{DateTime.Now:yyyyMMdd-HHmmss}.csv", csv, "text/csv");
    }

    private static string Trunc(string? s, int n) => string.IsNullOrEmpty(s) ? "" : s.Length <= n ? s : s[..n] + "…";
}
