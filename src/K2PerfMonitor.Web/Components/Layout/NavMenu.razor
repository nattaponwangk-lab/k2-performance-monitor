            <NavLink class="nav-link" href="alerts">
                <span class="ico">🚨</span> Alerts
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin">
            <div class="nav-item">
                <NavLink class="nav-link" href="instances">
                    <span class="ico">🖥️</span> Instances
                </NavLink>
            </div>
            <div class="nav-item">
