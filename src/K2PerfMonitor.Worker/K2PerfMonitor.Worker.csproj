    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.23" />
    <!-- override transitive Newtonsoft.Json 11.0.1 (Hangfire) — fixes GHSA-5crp-9r3c-p9vr -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.23" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\K2PerfMonitor.Core\K2PerfMonitor.Core.csproj" />
    <ProjectReference Include="..\K2PerfMonitor.Data\K2PerfMonitor.Data.csproj" />
    <ProjectReference Include="..\K2PerfMonitor.Collectors\K2PerfMonitor.Collectors.csproj" />
    <ProjectReference Include="..\K2PerfMonitor.Alerts\K2PerfMonitor.Alerts.csproj" />
    <ProjectReference Include="..\K2PerfMonitor.Notifications\K2PerfMonitor.Notifications.csproj" />
    <ProjectReference Include="..\K2PerfMonitor.Realtime\K2PerfMonitor.Realtime.csproj" />
  </ItemGroup>
</Project>
