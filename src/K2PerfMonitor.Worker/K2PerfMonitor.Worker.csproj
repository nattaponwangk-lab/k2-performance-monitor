<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-K2PerfMonitor.Worker-714132a6-4529-47ee-9b28-845038f341ca</UserSecretsId>
  </PropertyGroup>

  <!-- Data Protection (decrypt instance credentials — key ring shared with Web) -->
