# ---- K2 Performance Monitor — Worker (collectors + Hangfire + alert/notify) ----
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY K2PerformanceMonitor.sln ./
COPY src/K2PerfMonitor.Core/K2PerfMonitor.Core.csproj              src/K2PerfMonitor.Core/
COPY src/K2PerfMonitor.Data/K2PerfMonitor.Data.csproj              src/K2PerfMonitor.Data/
COPY src/K2PerfMonitor.Collectors/K2PerfMonitor.Collectors.csproj  src/K2PerfMonitor.Collectors/
COPY src/K2PerfMonitor.Alerts/K2PerfMonitor.Alerts.csproj          src/K2PerfMonitor.Alerts/
COPY src/K2PerfMonitor.Notifications/K2PerfMonitor.Notifications.csproj src/K2PerfMonitor.Notifications/
COPY src/K2PerfMonitor.Realtime/K2PerfMonitor.Realtime.csproj      src/K2PerfMonitor.Realtime/
COPY src/K2PerfMonitor.Worker/K2PerfMonitor.Worker.csproj          src/K2PerfMonitor.Worker/
RUN dotnet restore src/K2PerfMonitor.Worker/K2PerfMonitor.Worker.csproj

COPY src/ src/
RUN dotnet publish src/K2PerfMonitor.Worker/K2PerfMonitor.Worker.csproj -c Release -o /app /p:UseAppHost=false

# Worker ต้องมี ASP.NET runtime (Realtime มี FrameworkReference Microsoft.AspNetCore.App)
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
RUN adduser --disabled-password --gecos "" appuser
COPY --from=build /app ./
ENV DOTNET_ENVIRONMENT=Production
USER appuser
ENTRYPOINT ["dotnet", "K2PerfMonitor.Worker.dll"]
